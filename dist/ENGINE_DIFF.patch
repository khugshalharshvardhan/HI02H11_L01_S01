+.balloon.bcol-3 .bal-body{ background:#FFB0C8; color:#EE8BAC; }
+.balloon.bcol-4 .bal-body{ background:#9FE3D4; color:#6FC8B5; }
+.balloon.bcol-5 .bal-body{ background:#FFC49B; color:#EDA173; }
+@keyframes balFloat{ 0%,100%{ transform:translateY(0) rotate(-1.2deg); }
