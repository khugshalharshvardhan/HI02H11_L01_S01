+/* ============================================================================================
+   [S01r4] HI02H11_L01_S01 — SME round 4. Scoped additions only: every selector below is either a
+   brand-new class or a modifier no existing lesson sets, so nothing already built changes.
+   ============================================================================================ */
+
+/* ---- the repeated sound, wherever it is shown -------------------------------------------------
+   ONE highlight style for every occurrence, on every page. The deck says this four separate times
+   ("Use the same highlight style/colour for every क" / "...for every च"), so it is a single token
+   rather than a per-page colour. Amber over navy ink reads as emphasis, not as correctness —
+   deliberately NOT the green/red answer colours, which already mean something else in this engine. */
+:root{ --tgt-ink:#C2590A; --tgt-glow:rgba(255,176,54,.60); }
+/* COLOUR + GLOW, NOT A HIGHLIGHTER BOX. A background on an inline span is painted over the font's
+   full em box, and Baloo 2's descent is deep — so a wash hung under a Devanagari akshara renders as
+   a detached amber block sitting BELOW the letter (measured; it read as a stray box, not emphasis).
+   Recolouring the akshara is unambiguous, needs no box geometry, and survives any glyph. */
+.tgt-akshara{ color:var(--tgt-ink); text-shadow:0 0 .34em var(--tgt-glow);
+  transition:color .22s ease, text-shadow .22s ease; }
+
+/* ---- SENTENCE_SOUND teach flow ---------------------------------------------------------------- */
+/* the word currently being spoken — a lift, not a fill, so it never reads as "the answer" */
+.sentence-word.saying{ background:#EAF3FF; border-color:#8BBFFF;
+  transform:translateY(-4px); box-shadow:0 10px 22px rgba(56,106,246,.20); }
+/* the explanation pass: the WORD goes quiet again and only its target akshara stays lit — that is
+   the ask, verbatim: "Do not highlight the complete word; only highlight the target letter" */
+.sentence-word.marked{ background:#fff; border-color:#EEF3FA; }
+.sentence-word.marked .tgt-akshara{ text-shadow:0 0 .5em var(--tgt-glow); }
+.sentence-word.mark-now{ transform:translateY(-4px); }
+.sentence-word.mark-now .tgt-akshara{ animation:tgtPulse .62s ease-in-out 2; }
+@keyframes tgtPulse{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.16); } }
+/* the letter card is staged — it arrives when its sound plays, not before */
+.opt-cell.seq-hidden{ opacity:0; transform:scale(.86); pointer-events:none; }
+.opt-cell.ss-show{ opacity:1; transform:scale(1); transition:opacity .34s ease, transform .34s ease; }
+/* teach slide — there is nothing to pick, and one card must not inherit the 4-up grid's row
+   height: at min-height 184px it grew UP into the "फिर सुनो" replay pill (measured overlap 8px). */
+.opt-grid.ss-letter-card{ display:flex; justify-content:center; align-items:center;
+  margin-top:14px; pointer-events:none; }
+.opt-grid.ss-letter-card .opt-cell{ min-height:0; width:138px; height:138px; padding:6px; flex:0 0 auto; }
+
